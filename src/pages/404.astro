---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada | Agencia Manglar"
  description="La página que buscas no existe o cambió de dirección."
  path="/404/"
  noindex
  nav="minimal"
>
  <article class="legal">
    <div class="container legal__inner">
      <p class="eyebrow">Error 404</p>
      <h1>No encontramos esta página.</h1>
      <p>Es posible que la dirección haya cambiado o que el enlace tenga un error.</p>
      <p><a href="/">Ir al inicio</a> · <a href="/gestion-shein/">Gestión de catálogo en SHEIN</a> · <a href="/vender-en-shein/">Vender en SHEIN</a></p>
    </div>
  </article>
</Layout>
