---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Marketplaces from '../components/sections/Marketplaces.astro';
import Problems from '../components/sections/Problems.astro';
import Services from '../components/sections/Services.astro';
import Live from '../components/sections/Live.astro';
import Gallery from '../components/sections/Gallery.astro';
import Pricing from '../components/sections/Pricing.astro';
import Faq from '../components/sections/Faq.astro';
import { faqs, plans, site } from '../data/site';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site.url}/#servicio`,
  name: 'Operación de catálogos para marketplaces',
  serviceType: 'Gestión de catálogos ecommerce y publicación de productos en marketplaces',
  provider: { '@id': `${site.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'México' },
  availableLanguage: 'es-MX',
  description:
    'Fotografía comercial y optimización de catálogos, operación y diseño de tienda, gestión de campañas y promociones, y expansión a nuevos marketplaces: SHEIN, Mercado Libre y TikTok Shop. Incluye gestión de transmisiones de TikTok LIVE con presentador.',
  offers: plans.filter((plan) => plan.price).map((plan) => ({
    '@type': 'Offer',
    name: `Plan ${plan.name}`,
    description: `${plan.marketplaces} ${plan.marketplaces === 1 ? 'marketplace' : 'marketplaces'}`,
    price: plan.price,
    priceCurrency: 'MXN',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: plan.price,
      priceCurrency: 'MXN',
      unitText: 'MES',
    },
  })),
};

const liveSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site.url}/#tiktok-live`,
  name: 'Gestión de TikTok LIVE',
  serviceType: 'Producción y conducción de transmisiones de TikTok LIVE para ecommerce',
  provider: { '@id': `${site.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'México' },
  availableLanguage: 'es-MX',
  description:
    'Estrategia, presentador, operación de la transmisión y análisis posterior de sesiones de TikTok LIVE para marcas que venden en TikTok Shop México.',
};
---

<Layout
  title="Catálogos para marketplaces y TikTok LIVE | Agencia Manglar"
  description="Operamos tu catálogo en SHEIN, Mercado Libre y TikTok Shop y conducimos tus transmisiones de TikTok LIVE con presentador incluido. Diagnóstico gratuito."
  path="/"
  faqItems={faqs}
  schema={[serviceSchema, liveSchema]}
>
  <Hero
    eyebrow="Catálogos para marketplaces y TikTok LIVE en México"
    title={"Vende en marketplaces y en TikTok LIVE.\nNosotros hacemos el trabajo pesado."}
    subtitle="En Agencia Manglar nos encargamos de preparar fotografías, organizar productos y gestionar publicaciones en SHEIN, Mercado Libre y TikTok Shop. También producimos y conducimos tus transmisiones de TikTok LIVE."
    primaryLabel="Solicitar diagnóstico gratuito"
    secondaryLabel="Conocer TikTok LIVE"
    secondaryHref="#tiktok-live"
    trackLabel="hero_home"
  />
  <Gallery />
  <Live />
  <Marketplaces />
  <Problems />
  <Services intro={false} />
  <Pricing liveNote />
  <Faq items={faqs} />
</Layout>
