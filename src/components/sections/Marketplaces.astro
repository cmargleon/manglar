---
import { Image } from 'astro:assets';
import shein from '../../assets/images/manglar-galeria-bolso-beige-mujer.jpg';
import meli from '../../assets/images/manglar-galeria-mochila-gris-hombre.jpg';
import tiktok from '../../assets/images/manglar-galeria-sueter-rayas-hombre.jpg';
const photos = [
  { src: shein, alt: 'Fotografía de moda para SHEIN: mujer con bolso beige de hombro' },
  { src: meli, alt: 'Fotografía de producto para Mercado Libre: hombre de espaldas con mochila gris' },
  { src: tiktok, alt: 'Fotografía de moda para TikTok Shop: hombre con suéter de punto a rayas en gris, café y azul marino' },
];
import SectionHeader from '../SectionHeader.astro';
import Icon from '../Icon.astro';
import { marketplaces} from '../../data/site';

interface Props {
  title?: string;
  lead?: string;
}
const {
  title = 'Una sola operación para tus marketplaces.',
  lead = 'Acompañamos la operación de tu catálogo en los principales marketplaces de México, con criterios consistentes entre canales.',
} = Astro.props;
---

<section class="section section--tight section--market" aria-labelledby="marketplaces-title">
  <div class="container">
    <SectionHeader id="marketplaces-title" eyebrow="Marketplaces" title={title} lead={lead} />
    <ul class="market-grid" role="list">
      {marketplaces.map((m, i) => (
        <li data-reveal style={`--delay:${i * 60}ms`}>
          <div class="market-card">
          <h3 class="market-card__name">{m.name}</h3>
          <div class="market-card__photo"><Image src={photos[i % 3].src} alt={photos[i % 3].alt} widths={[400, 700]} sizes="(min-width: 768px) 33vw, 100vw" loading="lazy" /></div>
          <p>{m.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
