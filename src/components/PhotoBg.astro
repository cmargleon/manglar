---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// Fondo fotográfico decorativo con velo oscuro. Fotos de prueba (galería).
interface Props { src: ImageMetadata; position?: string; strength?: 'soft' | 'strong'; }
const { src, position = 'center', strength = 'strong' } = Astro.props;
---
<div class:list={['photo-bg', `photo-bg--${strength}`]} aria-hidden="true">
  <Image src={src} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="lazy" style={`object-position:${position}`} />
</div>
