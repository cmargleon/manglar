# Copia este archivo como .env y completa los valores antes de `npm run build`.
# Todas las variables PUBLIC_* quedan visibles en el HTML: no pongas aquí claves privadas.

# Opcional: ID de medición de Google Analytics 4 (G-XXXXXXXXXX). Si está vacío no se carga GA.
PUBLIC_GA4_ID=

# Opcional: dominio registrado en Plausible (por ejemplo agenciamanglar.mx). Si está vacío no se carga.
PUBLIC_PLAUSIBLE_DOMAIN=

# Opcional: token de verificación de Google Search Console por meta tag.
PUBLIC_GOOGLE_SITE_VERIFICATION=
